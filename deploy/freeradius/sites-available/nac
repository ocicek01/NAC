server nac {
	listen {
		type = auth
		ipaddr = *
		port = 1812
	}
	listen {
		type = acct
		ipaddr = *
		port = 1813
	}

	authorize {
		filter_username

		# Normalize common switch MAB identities before the NAC helper sees them.
		# Supported forms: aa:bb:cc:dd:ee:ff, aa-bb-cc-dd-ee-ff,
		# aabbccddeeff, and aabb.ccdd.eeff.
		if (&User-Name =~ /^([0-9A-Fa-f]{2})[:-]([0-9A-Fa-f]{2})[:-]([0-9A-Fa-f]{2})[:-]([0-9A-Fa-f]{2})[:-]([0-9A-Fa-f]{2})[:-]([0-9A-Fa-f]{2})$/) {
			update control {
				Tmp-String-0 := "%{toupper:%{1}}:%{toupper:%{2}}:%{toupper:%{3}}:%{toupper:%{4}}:%{toupper:%{5}}:%{toupper:%{6}}"
			}
		}
		elsif (&User-Name =~ /^([0-9A-Fa-f]{2})([0-9A-Fa-f]{2})([0-9A-Fa-f]{2})([0-9A-Fa-f]{2})([0-9A-Fa-f]{2})([0-9A-Fa-f]{2})$/) {
			update control {
				Tmp-String-0 := "%{toupper:%{1}}:%{toupper:%{2}}:%{toupper:%{3}}:%{toupper:%{4}}:%{toupper:%{5}}:%{toupper:%{6}}"
			}
		}
		elsif (&User-Name =~ /^([0-9A-Fa-f]{2})([0-9A-Fa-f]{2})\.([0-9A-Fa-f]{2})([0-9A-Fa-f]{2})\.([0-9A-Fa-f]{2})([0-9A-Fa-f]{2})$/) {
			update control {
				Tmp-String-0 := "%{toupper:%{1}}:%{toupper:%{2}}:%{toupper:%{3}}:%{toupper:%{4}}:%{toupper:%{5}}:%{toupper:%{6}}"
			}
		}

		if (&control:Tmp-String-0) {
			update request {
				User-Name := &control:Tmp-String-0
				Calling-Station-Id := &control:Tmp-String-0
			}
			nac_mab_authorize
			if (ok) {
				accept
			}
			reject
		}

		nac_eap
	}

	authenticate {
		nac_eap
	}

	accounting {
		detail
		unix
		nac_accounting
	}

	post-auth {
		Post-Auth-Type REJECT {
			attr_filter.access_reject
		}
	}
}
