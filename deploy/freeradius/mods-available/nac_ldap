ldap nac_ldap {
	server = "ldaps://@@LDAP_SERVER_FQDN@@"
	port = 636
	identity = "@@LDAP_BIND_DN@@"
	password = "@@LDAP_BIND_PASSWORD@@"
	base_dn = "@@LDAP_PEOPLE_BASE_DN@@"

	user {
		base_dn = "${..base_dn}"
		filter = "(uid=%{%{Stripped-User-Name}:-%{User-Name}})"
	}

	tls {
		start_tls = no
		ca_file = "@@LDAP_CA_FILE@@"
		require_cert = "demand"
	}

	timeout = 3
	net_timeout = 3
}
