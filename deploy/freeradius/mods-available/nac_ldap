ldap nac_ldap {
	server = "ldap://${LDAP_HOST}"
	port = 389
	identity = "${LDAP_BIND_DN}"
	password = "${LDAP_BIND_PASSWORD}"
	base_dn = "${LDAP_BASE_DN}"

	user {
		base_dn = "${..base_dn}"
		filter = "(uid=%{%{Stripped-User-Name}:-%{User-Name}})"
	}

	tls {
		start_tls = yes
		ca_file = "${LDAP_RADIUS_CA_FILE}"
		require_cert = "demand"
	}

	timeout = 3
	net_timeout = 3
}
